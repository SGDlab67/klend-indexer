# Runtime environment for the klend-indexer container on the Lightsail box.
#
# Copy to a ROOT-OWNED, chmod 600 file on the server (NOT in the repo, NOT in the
# image), e.g. /etc/klend-indexer.env, fill in the two secrets, and pass it with
# `docker run --env-file /etc/klend-indexer.env`. This file is the template only:
# it holds references and endpoints, never real secret values. See SECRETS.md.

# --- Alchemy (Yellowstone gRPC) ---
# Bare host; the token goes in the x-token header, never in the URL.
GRPC_URL=https://solana-mainnet.g.alchemy.com
# SECRET. The Alchemy key is a payment instrument (usage-based, no ceiling).
GRPC_TOKEN=

# --- ClickHouse Cloud (hosted sink, native-secure) ---
# host:port of the nativesecure endpoint. CLICKHOUSE_SECURE=1 turns on TLS; the
# host part doubles as the TLS SNI name.
CLICKHOUSE_URL=YOUR_INSTANCE.REGION.gcp.clickhouse.cloud:9440
CLICKHOUSE_SECURE=1
CLICKHOUSE_USER=default
CLICKHOUSE_DATABASE=klend
# SECRET. The ClickHouse Cloud SQL password for the user above.
CLICKHOUSE_PASSWORD=

# Leave KLEND_SAMPLE_SLOTS UNSET in production: unset means run unattended with the
# reconnect loop active. Setting it makes a bounded, single-shot sample that never
# reconnects. It exists for local measurement, not for the deployed service.
