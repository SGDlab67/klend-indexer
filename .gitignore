# Build artifacts (~870 MB — never commit)
/target

# Secrets. The Alchemy key lives in the macOS Keychain and must never reach a
# file (see SECRETS.md). These rules are defence in depth, not the mechanism.
.env
.env.*
*.env
!.env.example

# Cold-path Parquet output. A derived copy of ClickHouse, reproducible by
# re-running bin/parquet_export, and large: the payload column dominates.
/parquet

# OS / editor noise
.DS_Store

# ClickHouse env file (compose reads it automatically); password lives in the Keychain
.env
